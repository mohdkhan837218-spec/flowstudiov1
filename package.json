{
  "name": "flow-workspace",
  "version": "1.0.0",
  "description": "Multi-Account Browser Profile & Video Job Manager",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "compile:main": "tsc -p tsconfig.main.json",
    "compile:preload": "tsc -p tsconfig.preload.json",
    "compile": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "start:electron": "wait-on tcp:5173 && electron dist/main/index.js",
    "app:dev": "npm run compile && concurrently -k \"npm run dev\" \"npm run start:electron\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "electron",
    "playwright",
    "react",
    "browser-profiles",
    "multi-account",
    "flow-workspace"
  ],
  "author": "Flow Workspace Team",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "playwright": "^1.50.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2"
  }
}
